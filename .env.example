# Every VITE_-prefixed variable is inlined into the public client bundle at
# build time. Only put things here that you are happy to publish. Secrets
# (e.g. SUPABASE_SERVICE_ROLE_KEY, used by scripts/) must NOT carry the prefix.

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Sentry Configuration (Optional)
VITE_SENTRY_DSN=your_sentry_dsn

# Environment
VITE_ENV=development